  "description": "Paste a website URL and an API key to get a chatbot that adapts to the site, using hybrid RAG with Gemini, Claude or OpenAI.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test"
  },
  "keywords": [
