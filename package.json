    "hybrid-search",
    "express",
    "gemini",
    "claude",
    "openai"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "@huggingface/transformers": "^4.3.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.53.0",
    "robots-parser": "^3.0.1"
  }
