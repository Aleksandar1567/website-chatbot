# All of these are optional. You can also paste an API key into the web page.
# With no key in the page, the bot uses the first key it finds here, in this order.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Port for the local server (default: 3000)
PORT=3000

# How many pages to read from each site (default: 60)
# MAX_PAGES=60

# Set to 1 to allow addresses on this machine or your local network
# ALLOW_PRIVATE_URLS=1
